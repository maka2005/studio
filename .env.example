# Браузер (Vercel → Environment Variables). Публичные значения, секретов тут нет.
VITE_SUPABASE_URL=https://ezqelrhialezszepehco.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_pIKvCGwu1J_5qymj8m967Q_bAmnApaj
# Только Supabase Edge Functions (supabase secrets set ...). НЕ добавлять в Vercel.
# SUPABASE_URL, SUPABASE_ANON_KEY и SUPABASE_SERVICE_ROLE_KEY Supabase подставляет в функции сам.
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_DAILY_TOKEN_CAP=200000
VITE_TELEGRAM_BOT=firstnotification_bot
# Только Supabase Edge Functions; никогда не помещать в VITE_* или frontend env.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# CRON_SECRET=
# SITE_URL=https://your-domain.example
# Web Push: публичный ключ идёт во frontend, приватный — только в Supabase secrets.
# VITE_VAPID_PUBLIC_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@example.com

# Защита публичной формы заявок/демо (api/platform.js → Edge Function platform-admin).
# PLATFORM_PROXY_SECRET: одна и та же случайная строка (>=16 символов, например `openssl rand -hex 32`)
#   в Vercel (Environment Variables) И в Supabase (supabase secrets set PLATFORM_PROXY_SECRET=...).
#   Если задан, платформенные публичные формы принимаются только через /api/platform.
# PLATFORM_PROXY_SECRET=
# Cloudflare Turnstile (необязательно): сайт-ключ публичный (Vercel, VITE_*), секрет только в Supabase.
# VITE_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Аналитика и отслеживание ошибок (необязательно, публичные ключи/DSN):
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_YANDEX_METRIKA_ID=00000000
# VITE_SENTRY_DSN=https://<public>@o<org>.ingest.sentry.io/<project>
